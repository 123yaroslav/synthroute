{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/123yaroslav/synthroute/schemas/route/v0.1/route.schema.json",
  "title": "RouteSpec v0.1",
  "description": "Synthesis route with substances (nodes), steps (edges), scale parameters, provenance, verification statuses and metrics. See ADR-0003.",
  "type": "object",
  "required": ["schema_version", "route", "substances", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "route": {
      "type": "object",
      "required": ["id", "target_id", "title", "disclaimer"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target_id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "strategy_tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "disclaimer": { "type": "string", "minLength": 1, "description": "SAFE-004: routes require experimental verification by qualified specialists." },
        "version": { "type": "integer", "minimum": 1 },
        "parent_version": { "type": ["integer", "null"] }
      }
    },
    "substances": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/substance" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "metrics": { "$ref": "#/$defs/metrics" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "quantity": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "unit": { "enum": ["degC", "K", "bar", "atm", "h", "min", "s", "%", "L", "m3", "kg", "g", "kg/kg", "USD/kg", "EUR/kg", "RUB/kg"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["doi", "patent", "ord", "database", "expert", "model"] },
        "ref": { "type": "string", "minLength": 1, "description": "DOI, patent number, ORD reaction id, database URL, expert name, or model id" },
        "quote": { "type": "string", "description": "Verbatim supporting quote from the source (TRUST-004)" },
        "retrieved_at": { "type": "string", "format": "date" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["check_id", "check_version", "status"],
      "additionalProperties": false,
      "properties": {
        "check_id": { "type": "string", "pattern": "^RL[0-9]{3}$" },
        "check_version": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "message": { "type": "string" },
        "tool_versions": { "type": "object", "additionalProperties": { "type": "string" } },
        "checked_at": { "type": "string", "format": "date-time" }
      }
    },
    "status": {
      "description": "TRUST-002: literature = confirmed by literature, computed = confirmed by calculation, hypothesis = model hypothesis, failed = check not passed",
      "enum": ["literature", "computed", "hypothesis", "failed"]
    },
    "substance": {
      "type": "object",
      "required": ["id", "name", "smiles", "role", "sourcing"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "smiles": { "type": "string", "minLength": 1 },
        "inchikey": { "type": "string", "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$" },
        "role": { "enum": ["target", "intermediate", "starting_material", "reagent", "solvent", "catalyst", "byproduct"] },
        "sourcing": { "enum": ["buy", "make", "n/a"] },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["available", "limited", "unavailable", "unknown"] },
            "suppliers": { "type": "array", "items": { "type": "string" } },
            "price": { "$ref": "#/$defs/quantity" },
            "as_of": { "type": "string", "format": "date" },
            "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
          }
        }
      }
    },
    "participant": {
      "type": "object",
      "required": ["substance_id", "coefficient"],
      "additionalProperties": false,
      "properties": {
        "substance_id": { "$ref": "#/$defs/id" },
        "coefficient": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "scale_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reactor_volume": { "$ref": "#/$defs/quantity" },
        "equipment": { "type": "array", "items": { "enum": ["reactor", "flow_reactor", "filter", "extractor", "distillation", "crystallizer", "dryer", "chromatography", "other"] } },
        "isolation": { "type": "string" },
        "crystallization": { "type": "string" },
        "drying": { "type": "string" },
        "solvent_recycling": { "type": "boolean" }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "reaction_type", "inputs", "outputs", "provenance", "verification"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reaction_type": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/participant" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/participant" } },
        "agents": {
          "type": "object",
          "description": "Non-stoichiometric participants",
          "additionalProperties": false,
          "properties": {
            "solvent_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "catalyst_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          }
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": { "$ref": "#/$defs/quantity" },
            "pressure": { "$ref": "#/$defs/quantity" },
            "time": { "$ref": "#/$defs/quantity" },
            "atmosphere": { "type": "string" }
          }
        },
        "yield": { "$ref": "#/$defs/quantity" },
        "process_mode": { "enum": ["batch", "continuous", "unknown"] },
        "safety_notes": { "type": "array", "items": { "type": "string" } },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lab": { "$ref": "#/$defs/scale_params" },
            "pilot": { "$ref": "#/$defs/scale_params" },
            "plant": { "$ref": "#/$defs/scale_params" }
          }
        },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" }, "description": "Empty array is allowed but caps status at hypothesis (RL301)" },
        "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_count": { "type": "integer", "minimum": 0 },
        "overall_yield": { "$ref": "#/$defs/quantity" },
        "pmi": { "$ref": "#/$defs/quantity" },
        "e_factor": { "$ref": "#/$defs/quantity" },
        "raw_material_cost": { "$ref": "#/$defs/quantity" },
        "hazardous_step_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "solvent_classes": { "type": "object", "additionalProperties": { "enum": ["ICH_Q3C_1", "ICH_Q3C_2", "ICH_Q3C_3", "unclassified"] } }
      }
    }
  }
}
